# Optional. Node does not automatically load this file: export variables in your shell.
# The local launcher creates an ignored data/ingestion-key automatically.
# INCIDENTLAB_INGESTION_KEY=replace-with-at-least-24-random-characters
PORT=4317
SAMPLE_PORT=4318
# Set to 1 before starting the sample to use handled session expiry.
SAMPLE_FIXED=0
# Optional: use PostgreSQL instead of the default SQLite file. Run db:migrate first.
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/incidentlab
# Run npm.cmd run worker separately when this is external. The dev launcher does this for you.
# INCIDENTLAB_WORKER_MODE=external
# Optional port for the bundled development PostgreSQL server (dev:postgres).
# PG_DEV_PORT=54329
# Docker Compose only: random URI-safe password. Do not commit a populated .env file.
# POSTGRES_PASSWORD=replace-with-a-random-hex-password
