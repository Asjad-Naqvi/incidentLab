{
  "name": "incidentlab",
  "version": "0.7.0",
  "private": true,
  "description": "A local incident investigation and request replay lab",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:postgres": "node scripts/postgres-dev.mjs",
    "dev:collector": "node --experimental-sqlite --watch server.mjs",
    "sample": "node sample/server.mjs",
    "sample:traffic": "node scripts/sample-traffic.mjs",
    "start": "node --experimental-sqlite server.mjs",
    "worker": "node --experimental-sqlite worker.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "auth:setup": "node --experimental-sqlite scripts/auth-owner.mjs",
    "auth:password": "node --experimental-sqlite scripts/auth-owner.mjs --reset",
    "test:postgres": "node scripts/postgres-check.mjs",
    "test": "node --experimental-sqlite --test --test-concurrency=1",
    "demo": "node --experimental-sqlite demo-server.mjs",
    "benchmark": "node --experimental-sqlite scripts/benchmark.mjs"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "embedded-postgres": "^18.6.0-beta.19"
  }
}
